@charset "utf-8";

:root { --bg: #0d1117; --panel: #161b24; --panel-2: #1f2736; --border: #303b4e; --text: #f1f5f9; --muted: #94a3b8; --accent: #38d9a9; --radium: #4ade80; --polonium: #38bdf8; --amber: #f59e0b; --danger: #ef4444; }

* { box-sizing: border-box; margin: 0px; padding: 0px; }

html, body { height: 100dvh; width: 100vw; overflow: hidden; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 13px; user-select: none; }

.app { display: flex; flex-direction: column; height: 100dvh; width: 100%; padding: 8px; gap: 8px; position: relative; }

.topbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 7px 14px; flex-shrink: 0; }

.title-wrap { display: flex; align-items: center; gap: 10px; }

.title-wrap h1 { font-size: 15px; font-weight: 700; color: rgb(255, 255, 255); }

.pill-tag { font-size: 11px; font-weight: 600; background: rgb(30, 41, 59); color: var(--accent); border: 1px solid rgb(45, 74, 67); padding: 2px 9px; border-radius: 99px; }

.stage-dots { display: flex; align-items: center; gap: 6px; }

.stage-chip { font-size: 11px; font-weight: 600; padding: 4px 9px; border-radius: 5px; background: var(--panel-2); color: var(--muted); border: 1px solid var(--border); cursor: pointer; transition: 0.15s; }

.stage-chip:hover { color: rgb(255, 255, 255); border-color: rgb(75, 93, 122); }

.stage-chip.active { background: rgb(19, 59, 46); border-color: var(--accent); color: rgb(167, 243, 208); }

.stage { flex: 1 1 0%; min-height: 0px; display: grid; grid-template-columns: 1fr 285px; gap: 8px; }

.left-col { display: flex; flex-direction: column; min-height: 0px; gap: 8px; }

.bench-wrap { flex: 1 1 0%; min-height: 0px; position: relative; background: linear-gradient(rgb(19, 25, 36) 0%, rgb(11, 14, 20) 100%); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }

.story-banner { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 8px 10px; background: rgba(15, 20, 29, 0.94); border-bottom: 1px solid var(--border); flex-shrink: 0; }

.story-box { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; padding: 7px 10px; display: flex; flex-direction: column; gap: 2px; }

.story-box.highlight { border-color: rgb(47, 87, 76); background: rgb(18, 31, 34); }

.story-kicker { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.4px; color: var(--amber); }

.story-box.highlight .story-kicker { color: var(--accent); }

.story-heading { font-size: 12.5px; font-weight: 700; color: rgb(255, 255, 255); }

.story-desc { font-size: 11.5px; line-height: 1.35; color: rgb(203, 213, 225); }

.canvas-holder { flex: 1 1 0%; min-height: 0px; position: relative; }

#shedCanvas { width: 100%; height: 100%; display: block; cursor: grab; }

#shedCanvas:active { cursor: grabbing; }

.dock { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-shrink: 0; }

.dock-group { display: flex; align-items: center; gap: 6px; }

.dock-label { font-size: 11px; color: var(--muted); font-weight: 700; text-transform: uppercase; }

.btn { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 6px 11px; font-size: 12px; font-weight: 600; cursor: pointer; transition: 0.15s; white-space: nowrap; }

.btn:hover { background: rgb(42, 53, 72); border-color: rgb(75, 93, 122); }

.btn.active { background: rgb(19, 59, 46); border-color: var(--accent); color: rgb(167, 243, 208); }

.btn.amber { background: rgb(66, 44, 12); border-color: var(--amber); color: rgb(253, 230, 138); }

.btn.amber:hover { background: rgb(87, 58, 16); }

.btn.auto-on { background: rgb(92, 58, 10); border-color: rgb(251, 191, 36); color: rgb(254, 243, 199); box-shadow: rgba(245, 158, 11, 0.35) 0px 0px 10px; }

.btn.quiz-btn { background: rgb(20, 50, 77); border-color: var(--polonium); color: rgb(186, 230, 253); }

.sidebar { display: flex; flex-direction: column; min-height: 0px; gap: 8px; }

.card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; display: flex; flex-direction: column; gap: 6px; }

.card-header { display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 700; }

.badge { font-size: 11px; padding: 2px 7px; border-radius: 4px; background: rgb(19, 59, 46); color: var(--radium); border: 1px solid rgb(43, 92, 73); font-weight: 700; }

.meter-wrap { height: 98px; position: relative; background: rgb(8, 11, 16); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; flex-shrink: 0; }

#meterCanvas { width: 100%; height: 100%; display: block; }

.collected-hero { background: rgb(16, 25, 35); border: 1px solid rgb(43, 76, 67); border-radius: 7px; padding: 7px 10px; display: flex; flex-direction: column; gap: 2px; }

.collected-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); }

.collected-value { font-size: 16px; font-weight: 800; color: var(--radium); }

.collected-sub { font-size: 11px; color: rgb(148, 163, 184); }

.hours-hero { background: rgb(34, 25, 16); border: 1px solid rgb(107, 71, 25); border-radius: 7px; padding: 7px 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }

.hours-left { display: flex; flex-direction: column; gap: 1px; }

.hours-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; color: rgb(252, 211, 77); }

.hours-big { font-size: 22px; font-weight: 900; color: rgb(251, 191, 36); line-height: 1.1; }

.cycles-pill { text-align: right; background: var(--panel-2); border: 1px solid var(--border); border-radius: 6px; padding: 5px 8px; }

.cycles-lbl { font-size: 9.5px; color: var(--muted); text-transform: uppercase; font-weight: 700; }

.cycles-val { font-size: 12.5px; font-weight: 800; color: rgb(248, 250, 252); margin-top: 1px; }

.legend-card { flex: 1 1 0%; min-height: 0px; justify-content: center; background: rgb(18, 24, 34); }

.legend-row { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: rgb(226, 232, 240); }

.dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

.modal-backdrop { display: none; position: absolute; inset: 0px; background: rgba(7, 10, 15, 0.84); backdrop-filter: blur(3px); z-index: 20; align-items: center; justify-content: center; padding: 16px; }

.modal-backdrop.open { display: flex; }

.modal-box { background: var(--panel); border: 1px solid rgb(59, 75, 102); border-radius: 10px; width: 100%; max-width: 560px; max-height: 92%; display: flex; flex-direction: column; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.65) 0px 20px 50px; }

.modal-head { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: var(--panel-2); border-bottom: 1px solid var(--border); }

.modal-head h2 { font-size: 14px; font-weight: 700; }

.modal-body { padding: 12px 14px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }

.q-card { background: rgb(18, 23, 32); border: 1px solid var(--border); border-radius: 7px; padding: 9px 11px; display: flex; flex-direction: column; gap: 6px; }

.q-title { font-size: 12px; font-weight: 700; color: rgb(241, 245, 249); }

.q-opts { display: flex; flex-direction: column; gap: 4px; }

.opt-btn { text-align: left; background: var(--panel-2); border: 1px solid var(--border); color: var(--text); padding: 6px 9px; border-radius: 5px; font-size: 11.5px; cursor: pointer; transition: 0.15s; }

.opt-btn:hover { background: rgb(40, 51, 71); }

.opt-btn.correct { background: rgb(19, 59, 46); border-color: var(--accent); color: rgb(167, 243, 208); }

.opt-btn.wrong { background: rgb(59, 22, 25); border-color: var(--danger); color: rgb(254, 202, 202); }

.q-feedback { font-size: 11.5px; line-height: 1.35; display: none; }

.q-feedback.show { display: block; }
